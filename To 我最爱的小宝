<p class="p2"><br></p>
<p class="p1">&lt;script&gt;</p>
<p class="p1">// ===== 花瓣 =====</p>
<p class="p1">for (let i = 0; i &lt; 26; i++) {</p>
<p class="p1"><span class="Apple-converted-space">  </span>const p = document.createElement('div');</p>
